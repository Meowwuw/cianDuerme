rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esCuidador(babyId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.cuidadores;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /babies/{babyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.cuidadores;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.cuidadores;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.cuidadores;

      match /registros/{registroId} {
        allow read, write: if esCuidador(babyId);
      }
    }

    // los invites se generan y canjean solo vía Cloud Functions
    match /invites/{code} {
      allow read, write: if false;
    }
  }
}
