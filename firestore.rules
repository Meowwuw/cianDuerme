rules_version = '2';

// Reglas definitivas de "Cian duerme".
// Modelo: cada bebé tiene un array `cuidadores` (uids). Solo esos usuarios ven
// y editan el bebé y sus registros. Las invitaciones (`invites/{code}`) permiten
// que un usuario nuevo se sume como cuidador.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // ¿El usuario actual es cuidador del bebé `babyId`?
    function esCuidadorDe(babyId) {
      return autenticado()
        && request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.cuidadores;
    }

    // ── Cambios permitidos en cuidadores[] al editar un bebé ──
    // Desde el cliente NUNCA se agregan cuidadores (eso solo vía Cloud Function).
    function noAgregaCuidadores() {
      return request.resource.data.cuidadores.toSet()
        .difference(resource.data.cuidadores.toSet()).size() == 0;
    }
    // Cuidadores que se quitan en este update (set).
    function cuidadoresQuitados() {
      return resource.data.cuidadores.toSet()
        .difference(request.resource.data.cuidadores.toSet());
    }
    // Permitido: no agrega; y si quita, o no quita nada, o el que edita es el
    // creador (puede quitar a cualquiera), o se quita solo a sí mismo.
    function cambioCuidadoresOk() {
      return noAgregaCuidadores() && (
        cuidadoresQuitados().size() == 0
        || request.auth.uid == resource.data.creadoPor
        || cuidadoresQuitados() == [request.auth.uid].toSet()
      );
    }

    // Forma válida de un registro. inicio/fin se guardan como Timestamp.
    function registroValido(d) {
      return d.tipo in ['sueño', 'toma']
        && d.inicio is timestamp
        && (!('fin' in d) || d.fin == null || d.fin is timestamp);
    }

    // Forma válida de una comida. El cliente ya sanea momento y aceptacion en
    // ComidaContext, pero un bundle viejo en otro teléfono no pasa por ahí.
    //
    // hasOnly cierra el conjunto de campos: nada que no esté en esta lista
    // entra. Eso implica que agregar un campo pide tocar esta función ANTES
    // de que el cliente lo escriba, o el write rebota entero. Ya pasó con
    // `nombre` (paso 1.5); el próximo es el de alérgenos del paso 2.
    //
    // Ojo: Rules no tiene iteración, así que no se puede exigir que cada
    // elemento de `alimentos` sea un {id, nombre} de strings. Lo único
    // verificable es que sea una lista y que no sea absurdamente larga; el
    // contenido de cada elemento lo garantiza normalizarAlimento() y nada más.
    function comidaValida(d) {
      return d.keys().hasOnly(
          ['inicio', 'nombre', 'momento', 'alimentos', 'aceptacion', 'reaccion',
           'notas', 'creadoPor'])
        && d.inicio is timestamp
        && d.alimentos is list
        && d.alimentos.size() <= 30
        && (!('nombre' in d) || d.nombre == null || d.nombre is string)
        && (!('momento' in d) || d.momento == null
            || d.momento in ['desayuno', 'almuerzo', 'merienda', 'cena', 'extra'])
        && (!('aceptacion' in d) || d.aceptacion == null
            || d.aceptacion in ['todo', 'parte', 'probo', 'rechazo'])
        && (!('reaccion' in d) || d.reaccion == null || d.reaccion is string)
        && (!('notas' in d) || d.notas == null || d.notas is string)
        && (!('creadoPor' in d) || d.creadoPor == null || d.creadoPor is string);
    }

    match /babies/{babyId} {
      // Ver: solo cuidadores. (La query usa array-contains uid, que cumple esto.)
      allow read: if autenticado() && request.auth.uid in resource.data.cuidadores;

      // Crear: quien crea queda como único cuidador.
      allow create: if autenticado()
        && request.resource.data.cuidadores == [request.auth.uid]
        && request.resource.data.creadoPor == request.auth.uid;

      // Editar: cuidador existente. Además: `creadoPor` inmutable y cambios en
      // cuidadores[] acotados (no agrega; solo quitarse a sí mismo, salvo el
      // creador que puede quitar a otros). Sumar cuidadores va por la Cloud
      // Function `canjearInvite` (Admin SDK, saltea reglas).
      allow update: if autenticado()
        && request.auth.uid in resource.data.cuidadores
        && request.resource.data.creadoPor == resource.data.creadoPor
        && cambioCuidadoresOk();

      // Borrar el bebé (y en cascada sus datos): SOLO el creador (creadoPor).
      // Los demás cuidadores solo pueden "Salir" (quitarse de cuidadores).
      allow delete: if autenticado() && request.auth.uid == resource.data.creadoPor;

      // Registros (sueño / toma): solo cuidadores del bebé padre.
      // create/update validan la forma; delete no lleva datos.
      match /registros/{regId} {
        allow read, delete: if esCuidadorDe(babyId);
        allow create, update: if esCuidadorDe(babyId)
          && registroValido(request.resource.data);
      }

      // ── Alimentación complementaria ──
      // Igual que registros: lee y borra cualquier cuidador, y create/update
      // validan la forma. Además creadoPor es inmutable, como en el bebé:
      // dice quién cargó la comida, no quién la editó última.
      match /comidas/{comidaId} {
        allow read, delete: if esCuidadorDe(babyId);
        allow create: if esCuidadorDe(babyId)
          && comidaValida(request.resource.data);
        allow update: if esCuidadorDe(babyId)
          && comidaValida(request.resource.data)
          && request.resource.data.creadoPor == resource.data.creadoPor;
      }

      // Plan semanal y lista de compras. No asume nada del id del documento:
      // la semana la elige el cliente.
      match /planes/{planId} {
        allow read, write: if esCuidadorDe(babyId);
      }
    }

    // Preferencias por usuario (ej. notas de contexto apagadas). Cada quien solo
    // lee/escribe SU propio doc; nadie el de otro.
    match /users/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /invites/{code} {
      // Ya NO se lee ni se canjea el invite desde el cliente: el canje lo hace
      // la Cloud Function `canjearInvite` (Admin SDK, saltea estas reglas).
      allow get, list: if false;

      // Crear: un cuidador del bebé genera el invite para su bebé.
      allow create: if autenticado()
        && request.resource.data.creadoPor == request.auth.uid
        && esCuidadorDe(request.resource.data.babyId);

      // Canjear (marcar usado) NO se permite desde el cliente.
      allow update: if false;

      // Revocar / regenerar: un cuidador del bebé borra el invite.
      allow delete: if autenticado() && esCuidadorDe(resource.data.babyId);
    }
  }
}
